{
    "manifest_version": 3,
    "name": "Pájaros de Cartagena",
    "description": "Pájaros de Cartagena que revolotean por tu navegador. Basado en Pocket Bird, de Idrees Hassan.",
    "version": "__VERSION__",
    "homepage_url": "https://github.com/CasaAmarillaRoja/pajaros-de-cartagena",
    "icons": {
        "48": "images/icons/transparent/48x48x1.png",
        "96": "images/icons/transparent/96x96x1.png",
        "128": "images/icons/transparent/128x128x1.png"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "birb.js"
            ]
        }
    ],
    "permissions": [
        "storage"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "images/*",
                "fonts/Monocraft.otf"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "pajaros-de-cartagena@casaamarillaroja",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    }
}